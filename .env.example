# Copy to .env (git-ignored) and set your own values. Never commit .env.
# Used by docker-compose.yml (database) and the server (POSEFIT_* settings).

POSTGRES_USER=posefit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=posefit

# Must match the values above; port 5433 is the one docker-compose exposes on localhost.
POSEFIT_DATABASE_URL=postgresql://posefit:change-me@localhost:5433/posefit
